# Copier ce fichier vers .env puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être committé.

# --- Base de données PostgreSQL ---
# URL poolée, utilisée par l'application
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
# Connexion directe, utilisée par Prisma pour les migrations
DIRECT_URL=postgresql://user:password@host:5432/dbname

# --- Authentification (NextAuth v5) ---
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=change-me
AUTH_SECRET=change-me

# --- Stockage Cloudflare R2 ---
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=change-me
# URL publique du bucket (exposée au client)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Tâche planifiée ---
# Protège /api/cron/cleanup-r2
CRON_SECRET=change-me
